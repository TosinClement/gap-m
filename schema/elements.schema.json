{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://w3id.org/gap-m/schema/0.1.0/elements.schema.json",
 "title": "GAP-M source element registry",
 "description": "Verbatim source elements from the four frameworks.",
 "type": "array",
 "minItems": 1,
 "items": {
  "type": "object",
  "required": [
   "element_id",
   "framework",
   "level",
   "parent_id",
   "code",
   "label",
   "text",
   "locator",
   "mappable",
   "source_type",
   "obligation_holder"
  ],
  "properties": {
   "element_id": {
    "type": "string",
    "pattern": "^(RMF|A84|HTI|CPG):[A-Za-z0-9.\\-]+$"
   },
   "framework": {
    "enum": [
     "AI RMF 1.0",
     "NIST AI 800-4",
     "ONC HTI-1 (b)(11)",
     "CISA CPG 2.0"
    ]
   },
   "level": {
    "type": "string",
    "minLength": 1
   },
   "parent_id": {
    "type": [
     "string",
     "null"
    ]
   },
   "code": {
    "type": "string",
    "minLength": 1
   },
   "label": {
    "type": "string",
    "minLength": 1
   },
   "text": {
    "type": "string",
    "minLength": 1
   },
   "locator": {
    "type": "string",
    "minLength": 1
   },
   "mappable": {
    "type": "boolean"
   },
   "source_type": {
    "enum": [
     "guidance",
     "monitoring_challenge",
     "regulatory_disclosure_requirement",
     "voluntary_practice"
    ]
   },
   "obligation_holder": {
    "type": "string",
    "minLength": 3
   }
  }
 }
}