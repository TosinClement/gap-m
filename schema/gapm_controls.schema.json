{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://w3id.org/gap-m/schema/0.1.0/gapm_controls.schema.json",
 "title": "GAP-M controls",
 "description": "One object per GAP-M monitoring control.",
 "type": "array",
 "minItems": 1,
 "items": {
  "type": "object",
  "additionalProperties": false,
  "required": [
   "control_id",
   "family",
   "family_name",
   "a84_primary_category",
   "title",
   "objective",
   "activity",
   "evidence",
   "cadence",
   "owner_role",
   "links_total",
   "links_RMF",
   "links_A84",
   "links_HTI",
   "links_CPG",
   "review_status",
   "practice_type",
   "core",
   "author_response"
  ],
  "properties": {
   "control_id": {
    "type": "string",
    "pattern": "^GM-(GOV|FUN|FAIR|OPS|HF|SEC|CMP|LSI)-\\d{2}$"
   },
   "family": {
    "enum": [
     "GOV",
     "FUN",
     "FAIR",
     "OPS",
     "HF",
     "SEC",
     "CMP",
     "LSI"
    ]
   },
   "family_name": {
    "type": "string",
    "minLength": 1
   },
   "a84_primary_category": {
    "enum": [
     "XC",
     "FUN",
     "OPS",
     "HF",
     "SEC",
     "CMP",
     "LSI"
    ]
   },
   "title": {
    "type": "string",
    "minLength": 1
   },
   "objective": {
    "type": "string",
    "minLength": 1
   },
   "activity": {
    "type": "string",
    "minLength": 1
   },
   "evidence": {
    "type": "string",
    "minLength": 1
   },
   "cadence": {
    "type": "string",
    "minLength": 1
   },
   "owner_role": {
    "type": "string",
    "minLength": 1
   },
   "links_total": {
    "type": "integer",
    "minimum": 1
   },
   "links_RMF": {
    "type": "integer",
    "minimum": 0
   },
   "links_A84": {
    "type": "integer",
    "minimum": 0
   },
   "links_HTI": {
    "type": "integer",
    "minimum": 0
   },
   "links_CPG": {
    "type": "integer",
    "minimum": 0
   },
   "review_status": {
    "enum": [
     "proposed",
     "accepted",
     "revised",
     "rejected"
    ]
   },
   "practice_type": {
    "const": "suggested_practice"
   },
   "core": {
    "type": "string",
    "minLength": 10
   },
   "author_response": {
    "type": "string",
    "description": "The author's recorded response from the guided review, verbatim, or 'not_reviewed'."
   }
  }
 }
}
