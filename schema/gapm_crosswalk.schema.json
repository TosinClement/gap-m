{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://w3id.org/gap-m/schema/0.1.0/gapm_crosswalk.schema.json",
 "title": "GAP-M crosswalk bundle",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "gapm_version",
  "release_date",
  "doi",
  "mapping_style",
  "review_status",
  "sources",
  "controls",
  "links",
  "dispositions",
  "hti_attributes",
  "author_review",
  "coverage_statement",
  "source_types",
  "removed_links"
 ],
 "properties": {
  "gapm_version": {
   "type": "string",
   "pattern": "^\\d+\\.\\d+\\.\\d+$"
  },
  "release_date": {
   "type": "string"
  },
  "doi": {
   "type": "string"
  },
  "mapping_style": {
   "type": "string",
   "minLength": 1
  },
  "review_status": {
   "enum": [
    "proposed",
    "accepted",
    "revised",
    "rejected"
   ]
  },
  "sources": {
   "type": "array",
   "minItems": 4,
   "maxItems": 4,
   "items": {
    "type": "object",
    "required": [
     "id",
     "framework",
     "title",
     "publisher",
     "identifier",
     "doi",
     "date",
     "url"
    ]
   }
  },
  "controls": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "control_id",
     "family",
     "family_name",
     "a84_primary_category",
     "title",
     "objective",
     "activity",
     "evidence",
     "cadence",
     "owner_role",
     "links_total",
     "links_RMF",
     "links_A84",
     "links_HTI",
     "links_CPG",
     "review_status",
     "practice_type",
     "core",
     "author_response"
    ],
    "properties": {
     "control_id": {
      "type": "string",
      "pattern": "^GM-(GOV|FUN|FAIR|OPS|HF|SEC|CMP|LSI)-\\d{2}$"
     },
     "family": {
      "enum": [
       "GOV",
       "FUN",
       "FAIR",
       "OPS",
       "HF",
       "SEC",
       "CMP",
       "LSI"
      ]
     },
     "family_name": {
      "type": "string",
      "minLength": 1
     },
     "a84_primary_category": {
      "enum": [
       "XC",
       "FUN",
       "OPS",
       "HF",
       "SEC",
       "CMP",
       "LSI"
      ]
     },
     "title": {
      "type": "string",
      "minLength": 1
     },
     "objective": {
      "type": "string",
      "minLength": 1
     },
     "activity": {
      "type": "string",
      "minLength": 1
     },
     "evidence": {
      "type": "string",
      "minLength": 1
     },
     "cadence": {
      "type": "string",
      "minLength": 1
     },
     "owner_role": {
      "type": "string",
      "minLength": 1
     },
     "links_total": {
      "type": "integer",
      "minimum": 1
     },
     "links_RMF": {
      "type": "integer",
      "minimum": 0
     },
     "links_A84": {
      "type": "integer",
      "minimum": 0
     },
     "links_HTI": {
      "type": "integer",
      "minimum": 0
     },
     "links_CPG": {
      "type": "integer",
      "minimum": 0
     },
     "review_status": {
      "enum": [
       "proposed",
       "accepted",
       "revised",
       "rejected"
      ]
     },
     "practice_type": {
      "const": "suggested_practice"
     },
     "core": {
      "type": "string",
      "minLength": 10
     },
     "author_response": {
      "type": "string",
      "description": "The author's recorded response from the guided review, verbatim, or 'not_reviewed'."
     }
    }
   }
  },
  "links": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "link_id",
     "control_id",
     "target_id",
     "target_framework",
     "target_level",
     "target_code",
     "target_label",
     "relationship",
     "property",
     "rationale",
     "review_status",
     "mapping_style",
     "target_source_type",
     "audit_verdict",
     "audit_original_property",
     "audit_basis",
     "audit_condition",
     "conditional",
     "example_review",
     "example_review_note",
     "audit_relevance",
     "audit_relevance_basis",
     "audit_pass1_property",
     "author_response",
     "author_review_scope"
    ],
    "properties": {
     "link_id": {
      "type": "string",
      "pattern": "^GM-[A-Z]+-\\d{2}>(RMF|A84|HTI|CPG):"
     },
     "control_id": {
      "type": "string",
      "pattern": "^GM-(GOV|FUN|FAIR|OPS|HF|SEC|CMP|LSI)-\\d{2}$"
     },
     "target_id": {
      "type": "string",
      "pattern": "^(RMF|A84|HTI|CPG):[A-Za-z0-9.\\-]+$"
     },
     "target_framework": {
      "enum": [
       "AI RMF 1.0",
       "NIST AI 800-4",
       "ONC HTI-1 (b)(11)",
       "CISA CPG 2.0"
      ]
     },
     "target_level": {
      "type": "string",
      "minLength": 1
     },
     "target_code": {
      "type": "string",
      "minLength": 1
     },
     "target_label": {
      "type": "string",
      "minLength": 1
     },
     "relationship": {
      "const": "supports"
     },
     "property": {
      "enum": [
       "integral_to",
       "example_of",
       "precedes"
      ]
     },
     "rationale": {
      "type": "string",
      "minLength": 10,
      "pattern": "\\.$"
     },
     "review_status": {
      "enum": [
       "proposed",
       "accepted",
       "revised",
       "rejected"
      ]
     },
     "mapping_style": {
      "type": "string",
      "minLength": 1
     },
     "target_source_type": {
      "enum": [
       "guidance",
       "monitoring_challenge",
       "regulatory_disclosure_requirement",
       "voluntary_practice"
      ]
     },
     "audit_verdict": {
      "enum": [
       "supported",
       "revised",
       "unresolved",
       "not_audited"
      ]
     },
     "audit_original_property": {
      "enum": [
       "integral_to",
       "example_of",
       "precedes"
      ]
     },
     "audit_basis": {
      "type": [
       "string",
       "null"
      ]
     },
     "audit_condition": {
      "type": [
       "string",
       "null"
      ]
     },
     "conditional": {
      "type": "boolean"
     },
     "example_review": {
      "enum": [
       "keep",
       "revise",
       "not_applicable"
      ]
     },
     "example_review_note": {
      "type": [
       "string",
       "null"
      ]
     },
     "audit_relevance": {
      "enum": [
       "supported",
       "unsupported",
       null
      ]
     },
     "audit_relevance_basis": {
      "type": [
       "string",
       "null"
      ]
     },
     "audit_pass1_property": {
      "enum": [
       "integral_to",
       "example_of",
       "precedes",
       null
      ]
     },
     "author_response": {
      "type": "string",
      "description": "The author's recorded response from the guided review, verbatim, or 'not_reviewed'."
     },
     "author_review_scope": {
      "enum": [
       "census_integral_to",
       "census_conditional",
       "random_sample",
       "targeted_check",
       "not_sampled"
      ],
      "description": "Whether the link was in the author's individual review set (all integral_to, all conditional, the seeded 25% sample, or a targeted check) or not."
     }
    },
    "allOf": [
     {
      "if": {
       "properties": {
        "property": {
         "enum": [
          "integral_to",
          "precedes"
         ]
        }
       }
      },
      "then": {
       "properties": {
        "audit_verdict": {
         "const": "supported"
        }
       }
      }
     },
     {
      "if": {
       "properties": {
        "audit_verdict": {
         "const": "not_audited"
        }
       }
      },
      "then": {
       "properties": {
        "audit_basis": {
         "type": "null"
        }
       }
      },
      "else": {
       "properties": {
        "audit_basis": {
         "type": "string",
         "minLength": 10
        }
       }
      }
     },
     {
      "if": {
       "properties": {
        "audit_verdict": {
         "const": "unresolved"
        }
       }
      },
      "then": {
       "properties": {
        "audit_condition": {
         "type": "string",
         "minLength": 10
        },
        "property": {
         "const": "example_of"
        }
       }
      }
     },
     {
      "if": {
       "properties": {
        "conditional": {
         "const": true
        }
       }
      },
      "then": {
       "properties": {
        "audit_verdict": {
         "const": "unresolved"
        },
        "property": {
         "const": "example_of"
        }
       }
      }
     },
     {
      "if": {
       "properties": {
        "conditional": {
         "const": true
        }
       }
      },
      "then": {
       "properties": {
        "audit_relevance": {
         "const": "supported"
        },
        "audit_relevance_basis": {
         "type": "string",
         "minLength": 20
        }
       }
      }
     }
    ]
   }
  },
  "dispositions": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "element_id",
     "framework",
     "level",
     "parent_id",
     "code",
     "label",
     "disposition",
     "reason",
     "n_controls",
     "n_integral",
     "strongest_property",
     "controls",
     "review_status",
     "source_type"
    ],
    "properties": {
     "element_id": {
      "type": "string",
      "pattern": "^(RMF|A84|HTI|CPG):[A-Za-z0-9.\\-]+$"
     },
     "framework": {
      "enum": [
       "AI RMF 1.0",
       "NIST AI 800-4",
       "ONC HTI-1 (b)(11)",
       "CISA CPG 2.0"
      ]
     },
     "level": {
      "type": "string",
      "minLength": 1
     },
     "parent_id": {
      "type": [
       "string",
       "null"
      ]
     },
     "code": {
      "type": "string",
      "minLength": 1
     },
     "label": {
      "type": "string",
      "minLength": 1
     },
     "disposition": {
      "enum": [
       "mapped",
       "prerequisite",
       "out_of_scope",
       "uncovered"
      ]
     },
     "reason": {
      "type": [
       "string",
       "null"
      ]
     },
     "n_controls": {
      "type": "integer",
      "minimum": 0
     },
     "n_integral": {
      "type": "integer",
      "minimum": 0
     },
     "strongest_property": {
      "enum": [
       "integral_to",
       "example_of",
       "precedes",
       null
      ]
     },
     "controls": {
      "type": "string"
     },
     "review_status": {
      "enum": [
       "proposed",
       "accepted",
       "revised",
       "rejected"
      ]
     },
     "source_type": {
      "enum": [
       "guidance",
       "monitoring_challenge",
       "regulatory_disclosure_requirement",
       "voluntary_practice"
      ]
     }
    },
    "allOf": [
     {
      "if": {
       "properties": {
        "disposition": {
         "const": "mapped"
        }
       }
      },
      "then": {
       "properties": {
        "n_controls": {
         "minimum": 1
        },
        "reason": {
         "type": "null"
        }
       }
      },
      "else": {
       "properties": {
        "n_controls": {
         "const": 0
        },
        "reason": {
         "type": "string",
         "minLength": 10
        }
       }
      }
     }
    ]
   }
  },
  "hti_attributes": {
   "type": "array",
   "minItems": 31,
   "maxItems": 31,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "element_id",
     "cfr_paragraph",
     "attribute",
     "gapm_change_class",
     "must_indicate_if_not_available",
     "integral_controls",
     "precedes_controls",
     "example_controls"
    ],
    "properties": {
     "element_id": {
      "type": "string",
      "pattern": "^HTI:B[1-9]\\.[ivx]+$"
     },
     "cfr_paragraph": {
      "type": "string",
      "minLength": 1
     },
     "attribute": {
      "type": "string",
      "minLength": 1
     },
     "must_indicate_if_not_available": {
      "type": "boolean"
     },
     "integral_controls": {
      "type": "string"
     },
     "precedes_controls": {
      "type": "string"
     },
     "example_controls": {
      "type": "string"
     },
     "gapm_change_class": {
      "enum": [
       "static_at_release",
       "process_description",
       "evidence_accruing",
       "locally_measured"
      ]
     }
    }
   }
  },
  "author_review": {
   "enum": [
    "pending",
    "complete"
   ]
  },
  "coverage_statement": {
   "type": "string",
   "minLength": 40
  },
  "source_types": {
   "type": "object",
   "required": [
    "guidance",
    "monitoring_challenge",
    "regulatory_disclosure_requirement",
    "voluntary_practice",
    "suggested_practice"
   ]
  },
  "removed_links": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "link_id",
     "test",
     "basis",
     "scope"
    ]
   }
  }
 }
}
